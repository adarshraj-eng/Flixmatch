# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# ── Supabase ──────────────────────────────────────────────────────────
# Found at: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── TMDB ──────────────────────────────────────────────────────────────
# Found at: themoviedb.org → Settings → API
# Use the long "API Read Access Token" (starts with ey...)
VITE_TMDB_READ_ACCESS_TOKEN=your-tmdb-read-access-token-here

# ── Anthropic (Claude) ────────────────────────────────────────────────
# Found at: console.anthropic.com → API Keys
# NEVER use VITE_ prefix here — this must stay server-side only
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── RapidAPI (OTT Details) ────────────────────────────────────────────
# Found at: rapidapi.com → your app → API Key (X-RapidAPI-Key)
RAPIDAPI_KEY=your-rapidapi-key-here

# ── Server ────────────────────────────────────────────────────────────
PORT=3001
# In production, set this to your deployed frontend URL
ALLOWED_ORIGIN=http://localhost:5173
